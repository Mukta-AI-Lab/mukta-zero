# Mukta Zero — instance stack environment (template).
# Copie para `.env` ao lado do docker-compose.yml e preencha. NUNCA versionar o .env real.
# Gere segredos com: openssl rand -hex 32   (JWT_SECRET: >= 32 chars)

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# ── JWT / auth (GoTrue + PostgREST) ─────────────────────────────────────────
# ANON_KEY e SERVICE_ROLE_KEY são JWTs ASSINADOS com JWT_SECRET (roles "anon" e
# "service_role"). Gere-os depois de definir JWT_SECRET.
JWT_SECRET=
JWT_EXP=3600
JWT_ISSUER=supabase
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Realtime / storage ──────────────────────────────────────────────────────
SECRET_KEY_BASE=
POOLER_VAULT_ENC_KEY=
REALTIME_ENC_KEY=
POOLER_TENANT_ID=

# ── URLs públicas ───────────────────────────────────────────────────────────
API_EXTERNAL_URL=https://api.example.com
SITE_URL=https://app.example.com
ADDITIONAL_REDIRECT_URLS=

# ── Runtime ─────────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
EDGE_PORT=8000
MUKTA_PLAN=self-hosted
